# ===========================================
# OpenWA Environment (minimal, single-session)
# install.sh / run.py is file ko manage karta hai
# ===========================================

# Auto-start previously authenticated sessions on server boot
AUTO_START_SESSIONS=false

# Server
PORT=__PORT__
NODE_ENV=production

# Database (SQLite - no external service required)
DATABASE_TYPE=sqlite
DATABASE_NAME=./data/openwa.sqlite
DATABASE_SYNCHRONIZE=true
DATABASE_LOGGING=false

# WhatsApp Engine: whatsapp-web.js (recommended) ya baileys (lightweight)
ENGINE_TYPE=__ENGINE__
SESSION_DATA_PATH=./data/sessions
PUPPETEER_HEADLESS=true
PUPPETEER_ARGS=--no-sandbox,--disable-setuid-sandbox,--disable-dev-shm-usage,--disable-gpu

# Webhook
WEBHOOK_TIMEOUT=10000
WEBHOOK_RETRY_DELAY=5000

# Storage (Local filesystem)
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./data/media

# Redis & Queue (disabled for minimal setup)
REDIS_ENABLED=false
QUEUE_ENABLED=false
CACHE_ENABLED=false
